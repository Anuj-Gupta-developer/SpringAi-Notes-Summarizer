<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        PARENT: spring-boot-starter-parent
        ========================================
        This is the "magic" of Spring Boot — by declaring this parent POM,
        we inherit sensible default configurations for:
          - Plugin versions (maven-compiler-plugin, surefire, etc.)
          - Dependency versions (so we don't have to specify versions for
            common libraries like Jackson, Hibernate, Tomcat, etc.)
          - Resource filtering for application.properties

        WHY 3.3.13 and NOT Spring Boot 4?
        Spring Boot 4 is built on Spring Framework 7 and requires Java 21+.
        We're using 3.3.x (the last stable 3.x line) because:
          1. It works with Java 17 (which matches your other projects)
          2. Spring AI 1.1.x is designed for Boot 3.x
          3. More community support, tutorials, and Stack Overflow answers
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.13</version>
        <relativePath/> <!-- Lookup parent from Maven repository, not local filesystem -->
    </parent>

    <!-- YOUR PROJECT COORDINATES — how Maven identifies this project -->
    <groupId>com.anuj</groupId>
    <artifactId>notesai</artifactId>
    <version>1.0.0</version>
    <name>AI Notes Summarizer</name>
    <description>
        A Spring Boot REST API where users register, log in (JWT), paste text or upload PDFs,
        and receive AI-generated summaries. Built with Spring AI + Groq (free LLM API).
    </description>

    <properties>
        <!-- Java version for the maven-compiler-plugin -->
        <java.version>17</java.version>

        <!--
            Spring AI BOM version.
            WHY 1.1.8 and NOT 2.0.x?
            Spring AI 2.0 is a release candidate built on Spring Boot 4.
            Version 1.1.8 is the latest stable GA release that works with Boot 3.x.
            For a portfolio project, stable + well-documented > cutting-edge.
        -->
        <spring-ai.version>1.1.8</spring-ai.version>

        <!-- JJWT library version for creating/validating JSON Web Tokens -->
        <jjwt.version>0.13.0</jjwt.version>
    </properties>

    <!--
        DEPENDENCY MANAGEMENT (BOM = Bill of Materials)
        ================================================
        A BOM is a special POM that defines versions for a group of related libraries.
        By importing the Spring AI BOM here, we can use any Spring AI dependency
        below WITHOUT specifying a <version> — the BOM handles it.

        INTERVIEW TIP: "I used the Spring AI BOM to manage dependency versions centrally,
        which prevents version conflicts between Spring AI modules."
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- ==================== SPRING BOOT STARTERS ==================== -->

        <!--
            spring-boot-starter-web
            Brings in: Spring MVC, embedded Tomcat, Jackson (JSON serialization)
            This is what makes our app a REST API server.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            spring-boot-starter-security
            Brings in: Spring Security core, security filters, authentication/authorization
            This is what protects our endpoints with JWT authentication.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            spring-boot-starter-data-jpa
            Brings in: Spring Data JPA, Hibernate (ORM), transaction management
            This lets us use Repository interfaces instead of writing raw SQL.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            spring-boot-starter-validation
            Brings in: Jakarta Bean Validation (Hibernate Validator)
            This lets us use @NotBlank, @Size, @Valid, etc. on DTOs.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ==================== DATABASE ==================== -->

        <!--
            MySQL JDBC driver.
            scope=runtime means it's only needed at runtime (not at compile time)
            because our code talks to the database through JPA/Hibernate abstractions,
            never through the MySQL driver directly.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== JWT (JSON Web Tokens) ==================== -->

        <!--
            JJWT is split into 3 modules:

            1. jjwt-api    — The public API you code against (compile scope)
            2. jjwt-impl   — The internal implementation (runtime scope)
            3. jjwt-jackson — JSON processing using Jackson (runtime scope)

            WHY SPLIT?
            This follows the "API vs Implementation" pattern. Your code only depends
            on the API module. The implementation is a runtime detail that can be
            swapped without changing your code.

            INTERVIEW TIP: "JJWT uses a clean API-implementation split. My code
            only imports from jjwt-api, and the impl + jackson modules are loaded
            at runtime via the classpath."
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== SPRING AI ==================== -->

        <!--
            Spring AI OpenAI starter.
            Even though we're using Groq (not OpenAI), Groq's API is OpenAI-compatible.
            We just change the base-url in application.properties to point at Groq.
            This is the beauty of API compatibility — same client, different provider.

            NOTE: The artifact name changed in Spring AI 1.0+.
            Old (deprecated): spring-ai-openai-spring-boot-starter
            New (current):     spring-ai-starter-model-openai
            Version is managed by the Spring AI BOM above, so no <version> needed here.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
            Spring AI PDF Document Reader.
            Provides PagePdfDocumentReader which uses Apache PDFBox under the hood
            to extract text from PDF files. Used in Stage 3 for PDF upload feature.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pdf-document-reader</artifactId>
        </dependency>

        <!-- ==================== DEVELOPER TOOLS ==================== -->

        <!--
            Lombok — compile-time annotation processor that generates boilerplate code.
            @Data   → getters + setters + toString + equals + hashCode
            @NoArgsConstructor → no-args constructor (required by JPA)
            @AllArgsConstructor → constructor with all fields
            @Builder → builder pattern

            optional=true means Lombok won't be included in the final JAR
            (it's only needed during compilation).
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================== API DOCUMENTATION ==================== -->

        <!--
            SpringDoc OpenAPI — auto-generates Swagger UI for your REST API.
            After starting the app, visit: http://localhost:8080/swagger-ui.html
            It reads your @RestController annotations and generates interactive docs.

            WHY SpringDoc and not SpringFox?
            SpringFox is dead (no updates since 2020). SpringDoc is the actively
            maintained alternative that supports Spring Boot 3.x and Jakarta EE.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                Spring Boot Maven Plugin
                - Packages the app as an executable JAR/WAR
                - Provides `mvn spring-boot:run` command
                - We exclude Lombok from the final build (it's compile-time only)
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
